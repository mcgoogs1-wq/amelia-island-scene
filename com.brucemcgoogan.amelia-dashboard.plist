<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brucemcgoogan.amelia-dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/brucemcgoogan/Documents/Personal/Retirement calculator/amelia-dashboard/run_dashboard.sh</string>
    </array>

    <!-- Rebuild the dashboard twice a day: 7:00 AM and 4:00 PM. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>7</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <!-- Also rebuild once shortly after the Mac wakes / the agent loads. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/brucemcgoogan/Documents/Personal/Retirement calculator/amelia-dashboard/logs/dashboard.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/brucemcgoogan/Documents/Personal/Retirement calculator/amelia-dashboard/logs/dashboard.log</string>
</dict>
</plist>
